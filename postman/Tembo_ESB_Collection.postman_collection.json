{
	"info": {
		"_postman_id": "tembo-esb-zima-pay",
		"name": "Tembo ESB - ZIMA Pay",
		"description": "Test the Tembo Money Collection API through ZIMA ESB.\n\n**Setup:**\n1. Set `base_url` (e.g. http://127.0.0.1:8000) and ensure Laravel is running: `php artisan serve`\n2. Use Test Bank credentials (or your client API key/secret)\n3. For Money Collection: use a real Tanzanian mobile number (255...), amount >= 1000 TZS\n4. Tembo channel values: TZ-VODACOM-C2B (M-Pesa), TZ-AIRTEL-C2B, TZ-TIGO-C2B, TZ-HALOTEL-C2B",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000"
		},
		{
			"key": "api_key",
			"value": "test_bank_key_rXTAfjXdO1RuvICL"
		},
		{
			"key": "api_secret",
			"value": "test_bank_secret_waKb28JCEyBTfj33gTx8Fr4AFPH92Hiq"
		},
		{
			"key": "customer_phone",
			"value": "255767582837"
		},
		{
			"key": "reference",
			"value": "TEST_{{$timestamp}}_postman"
		}
	],
	"item": [
		{
			"name": "Health",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/esb/health",
					"host": ["{{base_url}}"],
					"path": ["api", "esb", "health"]
				},
				"description": "ESB health check. No auth required."
			}
		},
		{
			"name": "Get Services",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-API-Key",
						"value": "{{api_key}}",
						"type": "text"
					},
					{
						"key": "X-API-Secret",
						"value": "{{api_secret}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/esb/services",
					"host": ["{{base_url}}"],
					"path": ["api", "esb", "services"]
				},
				"description": "List available services for the authenticated client (Test Bank). Returns MONEY_COLLECTION, COLLECTION_BALANCE, COLLECTION_STATEMENT, PAYMENT_STATUS."
			}
		},
		{
			"name": "Money Collection",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-API-Key",
						"value": "{{api_key}}",
						"type": "text"
					},
					{
						"key": "X-API-Secret",
						"value": "{{api_secret}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"customer_phone\": \"{{customer_phone}}\",\n  \"mobile_network\": \"TZ-VODACOM-C2B\",\n  \"amount\": 1000,\n  \"description\": \"Test payment from Postman\",\n  \"reference\": \"{{reference}}\",\n  \"date\": \"{{$isoTimestamp}}\",\n  \"webhook_url\": \"https://webhook.site/your-unique-url\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/esb/MONEY_COLLECTION",
					"host": ["{{base_url}}"],
					"path": ["api", "esb", "MONEY_COLLECTION"]
				},
				"description": "Trigger a Tembo collection (USSD push). Amount must be >= 1000 TZS. Channel: TZ-VODACOM-C2B (M-Pesa), TZ-AIRTEL-C2B, TZ-TIGO-C2B, TZ-HALOTEL-C2B. Response may be status pending (PENDING_ACK), success (PAYMENT_ACCEPTED), or failed (PROVIDER_FAILED if customer cancels or timeout)."
			}
		},
		{
			"name": "Money Collection (Airtel)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-API-Key",
						"value": "{{api_key}}",
						"type": "text"
					},
					{
						"key": "X-API-Secret",
						"value": "{{api_secret}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"customer_phone\": \"{{customer_phone}}\",\n  \"mobile_network\": \"TZ-AIRTEL-C2B\",\n  \"amount\": 1000,\n  \"description\": \"Test Airtel from Postman\",\n  \"reference\": \"{{reference}}\",\n  \"date\": \"{{$isoTimestamp}}\",\n  \"webhook_url\": \"https://webhook.site/your-unique-url\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/esb/MONEY_COLLECTION",
					"host": ["{{base_url}}"],
					"path": ["api", "esb", "MONEY_COLLECTION"]
				},
				"description": "Same as Money Collection but with TZ-AIRTEL-C2B for Airtel Money."
			}
		},
		{
			"name": "Collection Balance",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-API-Key",
						"value": "{{api_key}}",
						"type": "text"
					},
					{
						"key": "X-API-Secret",
						"value": "{{api_secret}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{}"
				},
				"url": {
					"raw": "{{base_url}}/api/esb/COLLECTION_BALANCE",
					"host": ["{{base_url}}"],
					"path": ["api", "esb", "COLLECTION_BALANCE"]
				},
				"description": "Get Tembo collection account balance."
			}
		},
		{
			"name": "Collection Statement",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-API-Key",
						"value": "{{api_key}}",
						"type": "text"
					},
					{
						"key": "X-API-Secret",
						"value": "{{api_secret}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"start_date\": \"2025-01-01\",\n  \"end_date\": \"2025-12-31\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/esb/COLLECTION_STATEMENT",
					"host": ["{{base_url}}"],
					"path": ["api", "esb", "COLLECTION_STATEMENT"]
				},
				"description": "Get collection account statement for date range. Use start_date and end_date (YYYY-MM-DD)."
			}
		},
		{
			"name": "Payment Status",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-API-Key",
						"value": "{{api_key}}",
						"type": "text"
					},
					{
						"key": "X-API-Secret",
						"value": "{{api_secret}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"transaction_id\": \"PASTE_TEMBO_TRANSACTION_ID_HERE\",\n  \"reference\": \"PASTE_YOUR_REFERENCE_HERE\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/esb/PAYMENT_STATUS",
					"host": ["{{base_url}}"],
					"path": ["api", "esb", "PAYMENT_STATUS"]
				},
				"description": "Check status of a collection. Use transaction_id from Money Collection response and your reference."
			}
		}
	]
}
